{
  "name": "agent-diff-review-vscode",
  "displayName": "agent-diff-review",
  "version": "1.1.1",
  "private": true,
  "description": "Visual review and line-level accept/reject for AI-generated code changes.",
  "license": "MIT",
  "publisher": "agent-diff-review",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agentDiffReview.open",
    "onCommand:agentDiffReview.applyDecisions"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentDiffReview.open",
        "title": "Agent Diff Review: Open Native Review"
      },
      {
        "command": "agentDiffReview.applyDecisions",
        "title": "Agent Diff Review: Apply Decisions"
      }
    ],
    "configuration": {
      "title": "agent-diff-review",
      "properties": {
        "agentDiffReview.adrPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a custom adr binary. Leave empty to use the bundled binary."
        },
        "agentDiffReview.autoReview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan the Git worktree and show inline accept/reject actions when changed files are opened."
        },
        "agentDiffReview.autoReviewDelayMs": {
          "type": "number",
          "default": 1000,
          "minimum": 250,
          "description": "Debounce delay before automatically refreshing inline review decorations."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3"
  }
}

